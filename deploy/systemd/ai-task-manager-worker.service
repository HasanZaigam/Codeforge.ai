# systemd unit for the worker process — see docs/DEPLOYMENT.md "Production
# deployment". Genuinely separate service/process from the API unit (TD-16):
# independently started, stopped, and restarted.
#
# Install:
#   sudo cp deploy/systemd/ai-task-manager-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-task-manager-worker
#
# Secrets: /etc/ai-task-manager/worker.env (root-owned, 0600, not in this
# repo) — see docs/DEPLOYMENT.md "Secrets configuration". In practice this
# file and api.env share most of the same values (DB_PATH, WORKSPACES_ROOT,
# CREDENTIAL_ENCRYPTION_KEY must be identical across both processes); keeping
# them as two files (rather than one shared file) lets each unit's
# process-specific variables (PORT vs POLL_INTERVAL_MS/WORKER_ID) live next to
# the process that reads them, without forcing an artificial split of the
# shared values — duplicate the shared lines across both files at deploy time.

[Unit]
Description=AI Task Manager - worker process
Documentation=https://github.com/your-org/AI_Task_Manager/blob/main/docs/DEPLOYMENT.md
After=network.target

[Service]
Type=simple
User=aitaskmanager
Group=aitaskmanager
WorkingDirectory=/opt/ai-task-manager
EnvironmentFile=/etc/ai-task-manager/worker.env
ExecStart=/usr/bin/node dist/src/worker/run-worker.js
Restart=on-failure
RestartSec=3

# SIGTERM triggers src/worker/run-worker.ts's own graceful shutdown: stop
# claiming new tasks, let whatever's already executing finish naturally
# (never cancelled mid-flight — that's intentional, see docs/DEPLOYMENT.md
# "Graceful shutdown"), bounded at 30s internally before it force-exits and
# lets lease-expiry/crash-recovery pick the task back up on the next claim.
# A worker mid-task can legitimately take a while to reach a safe checkpoint,
# so give it noticeably more real time than the API unit before SIGKILL —
# but the internal 30s bound plus recovery means a slow/stuck worker restart
# is never actually unsafe even if this timeout is hit.
TimeoutStopSec=45
KillSignal=SIGTERM

# --- Hardening (same rationale as the API unit) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The worker needs write access to both the SQLite file (same as the API
# unit) AND the workspaces directory (git clones/worktrees it provisions and
# tears down per task) — match DB_PATH's and WORKSPACES_ROOT's parent
# directories in worker.env. `git` itself (spawned as a child process) also
# needs to run here, which ProtectSystem=strict does not block.
ReadWritePaths=/opt/ai-task-manager/.data
ProtectHome=true

[Install]
WantedBy=multi-user.target
