{
  "name": "ai-task-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Software Development Platform - backend execution foundation",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "demo": "tsx src/cli/demo.ts",
    "api": "tsx src/api/server.ts",
    "worker": "tsx src/worker/run-worker.ts",
    "dev": "tsx src/dev.ts",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "express": "^4.22.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
