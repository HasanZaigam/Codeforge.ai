{
  "name": "codeforge",
  "version": "0.1.0",
  "private": true,
  "description": "Codeforge.ai - Autonomous Software Development Platform",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/persistence/migrations && cp src/persistence/migrations/*.sql dist/src/persistence/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/**/*.test.ts",
    "demo": "tsx src/cli/demo.ts",
    "validate:backlog": "node --env-file-if-exists=.env --import tsx src/cli/validate-backlog-analysis.ts",
    "benchmark:retrieval": "node --import tsx src/cli/benchmark-retrieval.ts",
    "validate:adjudication": "node --env-file-if-exists=.env --import tsx src/cli/validate-adjudication.ts",
    "validate:bulk-backlog": "node --env-file-if-exists=.env --import tsx src/cli/validate-bulk-backlog.ts",
    "validate:claim-verification": "node --env-file-if-exists=.env --import tsx src/cli/validate-claim-verification.ts",
    "validate:task-usage": "node --env-file-if-exists=.env --import tsx src/cli/validate-task-usage.ts",
    "api": "node --env-file-if-exists=.env --import tsx src/api/server.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/run-worker.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/dev.ts",
    "start:api": "node dist/src/api/server.js",
    "start:worker": "node dist/src/worker/run-worker.js",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
